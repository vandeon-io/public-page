---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FitMeter from '../components/FitMeter.astro';
import HeroViz from '../components/HeroViz.jsx';
import { LINKS } from '../consts.js';
---
<Base
  title="Vandeon — your app, live. Automatically."
  description="Set it up once. Vandeon puts your entire app online, sized to what it needs, and keeps it running the right way. From solo founders to big-tech scale."
>
  <div data-screen-label="01 Landing">
    <div class="wrap">
      <Nav current="product" />

      <!-- Hero -->
      <section class="hero">
        <div class="hero-grid">
          <div class="hero-text reveal in">
            <span class="kbd-tag"><span class="kbd-dot"></span> automatic, after a simple setup</span>
            <h1 class="hero-h">Your app, live.<br /><em>Automatically.</em></h1>
            <p class="hero-sub">
              Set it up once. Vandeon puts your entire app online and keeps it running.
            </p>
            <div class="hero-cta">
              <a class="btn btn-primary btn-lg" href={LINKS.app} target="_blank" rel="noopener">
                launch app <span class="btn-arrow">→</span>
              </a>
              <a class="btn btn-ghost btn-lg" href="#how">see what you pay for</a>
            </div>
            <div class="hero-trust">
              <span>ready for real customers</span>
              <span class="hero-trust-sep"></span>
              <span>best practices built in</span>
            </div>
          </div>

          <div class="hero-visual reveal in">
            <HeroViz client:load variant="flow" accent="var(--accent)" />
            <div class="viz-caption">
              <span><b>you</b> set up once → <b>vandeon</b> does the rest</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Right-sized (id kept as "how" for the nav/footer "product" links) -->
      <section class="section" id="how">
        <div class="sect-head reveal">
          <span class="sect-tag">§ right-sized</span>
          <h2 class="sect-h">Pay for what your app needs. <em>Nothing more.</em></h2>
          <p class="sect-sub">Vandeon sizes your system to fit, and adjusts it as your app grows.</p>
        </div>
        <div class="fits reveal">
          <article class="fit">
            <span class="fit-k">too little</span>
            <span class="fit-rule"></span>
            <h3 class="fit-title">Struggles when it counts</h3>
            <p class="fit-body">Not enough room, so your app slows down or goes offline right when people show up.</p>
            <div class="fit-glyph"><FitMeter kind="under" cap={42} need={70} note="needs more than it has" /></div>
          </article>
          <article class="fit is-featured">
            <span class="fit-k">right-sized · vandeon</span>
            <span class="fit-rule"></span>
            <h3 class="fit-title">Exactly what it needs</h3>
            <p class="fit-body">Enough room for your app to run well, adjusted as it grows. You pay for what it uses.</p>
            <div class="fit-glyph"><FitMeter kind="fit" cap={78} need={70} note="fits, with room to breathe" /></div>
          </article>
          <article class="fit">
            <span class="fit-k">too much</span>
            <span class="fit-rule"></span>
            <h3 class="fit-title">Paying for their ecosystem</h3>
            <p class="fit-body">Big platforms run as huge ecosystems. Each service you use carries part of the cost of running all of it, so you pay more than your app needs.</p>
            <div class="fit-glyph"><FitMeter kind="over" cap={100} need={30} note="mostly their overhead, not your app" /></div>
          </article>
        </div>
        <div class="fit-legend reveal">
          <span><i class="fit-key fit-key--use"></i> what your app uses</span>
          <span><i class="fit-key fit-key--pay"></i> what you pay for</span>
        </div>
      </section>

      <!-- Who it's for -->
      <section class="section" id="who">
        <div class="sect-head reveal">
          <span class="sect-tag">§ who it's for</span>
          <h2 class="sect-h">From your first app to <em>big-tech scale</em>.</h2>
          <p class="sect-sub">Vandeon steps in as the operations team you'd otherwise have to hire, shaped around where you are today.</p>
        </div>
        <div class="tiers reveal">
          {[
            { k: 'just you', t: 'Solo founders', b: 'Launch properly from day one, without hiring anyone to run it.' },
            { k: 'a small team', t: 'Startups', b: 'Move fast without cutting corners. Your setup is ready when growth hits.' },
            { k: 'a growing business', t: 'Small & medium businesses', b: 'Keep everything reliable and costs in check, without a full-time team.' },
            { k: 'many teams', t: 'Enterprise', b: 'One consistent way of running every system. Updates go live only when someone approves them.' },
            { k: 'massive scale', t: 'Big-tech scale', b: 'The same discipline across a huge number of systems, each one sized right.' },
          ].map((tier, i) => (
            <article class="tier">
              <span class="tier-scale" aria-hidden="true">
                {[0, 1, 2, 3, 4].map((n) => <i class={n <= i ? 'on' : ''}></i>)}
              </span>
              <span class="tier-k">{tier.k}</span>
              <h3 class="tier-t">{tier.t}</h3>
              <p class="tier-b">{tier.b}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- CTA band -->
      <section class="cta-band reveal">
        <h2 class="cta-h">Run your app the right way.</h2>
        <p class="cta-sub">Properly set up, sized to fit, and looked after, whether it's your first app or your hundredth.</p>
        <div class="cta-actions">
          <a class="btn btn-primary btn-lg" href={LINKS.app} target="_blank" rel="noopener">
            launch app <span class="btn-arrow">→</span>
          </a>
        </div>
      </section>

      <Footer />
    </div>
  </div>
</Base>
