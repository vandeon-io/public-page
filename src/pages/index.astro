---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FitMeter from '../components/FitMeter.astro';
import HeroViz from '../components/HeroViz.jsx';
import { LINKS } from '../consts.js';
---
<Base
  title="Vandeon — deploy full-stack systems, at vps prices"
  description="Vandeon deploys your frontend, backend, and database on plain VPS servers — no hyperscaler markup. From a side project to a small company."
>
  <div data-screen-label="01 Landing">
    <div class="wrap">
      <Nav current="product" />

      <!-- Hero -->
      <section class="hero">
        <div class="hero-grid">
          <div class="hero-text reveal in">
            <span class="kbd-tag"><span class="kbd-dot"></span> automatic, after a simple setup</span>
            <h1 class="hero-h">Your app, live.<br /><em>Automatically.</em></h1>
            <p class="hero-sub">
              Set it up once. Vandeon puts your entire app online and keeps it running.
            </p>
            <div class="hero-cta">
              <a class="btn btn-primary btn-lg" href={LINKS.app} target="_blank" rel="noopener">
                launch app <span class="btn-arrow">→</span>
              </a>
              <a class="btn btn-ghost btn-lg" href="#how">see what you pay for</a>
            </div>
            <div class="hero-trust">
              <span>ready for real customers</span>
              <span class="hero-trust-sep"></span>
              <span>best practices built in</span>
            </div>
          </div>

          <div class="hero-visual reveal in">
            <HeroViz client:load variant="flow" accent="var(--accent)" />
            <div class="viz-caption">
              <span><b>you</b> set up once → <b>vandeon</b> does the rest</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Right-sized (id kept as "how" for the nav/footer "product" links) -->
      <section class="section" id="how">
        <div class="sect-head reveal">
          <span class="sect-tag">§ right-sized</span>
          <h2 class="sect-h">Pay for what your app needs. <em>Nothing more.</em></h2>
          <p class="sect-sub">Vandeon sizes your system to fit, and adjusts it as your app grows.</p>
        </div>
        <div class="fits reveal">
          <article class="fit">
            <span class="fit-k">too little</span>
            <span class="fit-rule"></span>
            <h3 class="fit-title">Struggles when it counts</h3>
            <p class="fit-body">Not enough room, so your app slows down or goes offline right when people show up.</p>
            <div class="fit-glyph"><FitMeter kind="under" cap={42} need={70} note="needs more than it has" /></div>
          </article>
          <article class="fit is-featured">
            <span class="fit-k">right-sized · vandeon</span>
            <span class="fit-rule"></span>
            <h3 class="fit-title">Exactly what it needs</h3>
            <p class="fit-body">Enough room for your app to run well, adjusted as it grows. You pay for what it uses.</p>
            <div class="fit-glyph"><FitMeter kind="fit" cap={78} need={70} note="fits, with room to breathe" /></div>
          </article>
          <article class="fit">
            <span class="fit-k">too much</span>
            <span class="fit-rule"></span>
            <h3 class="fit-title">Paying for their ecosystem</h3>
            <p class="fit-body">Big platforms run as huge ecosystems. Each service you use carries part of the cost of running all of it, so you pay more than your app needs.</p>
            <div class="fit-glyph"><FitMeter kind="over" cap={100} need={30} note="mostly their overhead, not your app" /></div>
          </article>
        </div>
        <div class="fit-legend reveal">
          <span><i class="fit-key fit-key--use"></i> what your app uses</span>
          <span><i class="fit-key fit-key--pay"></i> what you pay for</span>
        </div>
      </section>

      <!-- Capabilities -->
      <section class="section" style="padding-top: 0; border-top: none;">
        <div class="sect-head reveal" style="margin-bottom: 40px;">
          <span class="sect-tag">§ what you get</span>
          <h2 class="sect-h">One console. The whole lifecycle.</h2>
        </div>
        <div class="caps reveal">
          <div class="cap">
            <div class="cap-k">PROVISION</div>
            <div class="cap-t">Servers, set up</div>
            <p class="cap-b">Networking, users, runtimes and dependencies configured for you on connect.</p>
          </div>
          <div class="cap">
            <div class="cap-k">DEPLOY</div>
            <div class="cap-t">One-click rollouts</div>
            <p class="cap-b">Ship a new version across the fleet, with safe rollback the moment health drifts.</p>
          </div>
          <div class="cap">
            <div class="cap-k">OBSERVE</div>
            <div class="cap-t">Health at a glance</div>
            <p class="cap-b">Status, metrics and logs wired up automatically the moment a service comes online.</p>
          </div>
          <div class="cap">
            <div class="cap-k">CONTROL</div>
            <div class="cap-t">From one to many</div>
            <p class="cap-b">The same simple console whether you run a single box or a multi-region fleet.</p>
          </div>
        </div>
      </section>

      <!-- Economics -->
      <section class="section" style="padding-top: 0; border-top: none;">
        <div class="sect-head reveal" style="margin-bottom: 40px;">
          <span class="sect-tag">§ pricing</span>
          <h2 class="sect-h">VPS economics, not <em>hyperscaler prices</em>.</h2>
          <p class="sect-sub">Frontend, backend, and database each run as plain virtual servers — not managed services billed by the request. You're renting the box, not someone else's markup on it.</p>
        </div>
        <div class="caps reveal" style="grid-template-columns: repeat(3, 1fr);">
          <div class="cap">
            <div class="cap-k">COMPUTE</div>
            <div class="cap-t">Plain vps pricing</div>
            <p class="cap-b">A flat monthly rate per server — the same instance you could rent directly, not a managed-service surcharge.</p>
          </div>
          <div class="cap">
            <div class="cap-k">NO METERING</div>
            <div class="cap-t">Flat, predictable bills</div>
            <p class="cap-b">No per-request fees, no metered egress, no surprise line items at the end of the month.</p>
          </div>
          <div class="cap">
            <div class="cap-k">RIGHT-SIZED</div>
            <div class="cap-t">Side project to small company</div>
            <p class="cap-b">Sized for real small-to-medium teams — not enterprise tiers built around hyperscaler contracts.</p>
          </div>
        </div>
      </section>

      <!-- CTA band -->
      <section class="cta-band reveal">
        <h2 class="cta-h">Stop paying hyperscaler prices.</h2>
        <p class="cta-sub">Let Vandeon provision, configure, and run your frontend, backend, and database — on plain vps pricing, from a side project to a small company.</p>
        <div class="cta-actions">
          <a class="btn btn-primary btn-lg" href={LINKS.app} target="_blank" rel="noopener">
            launch app <span class="btn-arrow">→</span>
          </a>
          <a class="btn btn-ghost btn-lg" href="#how">see how it works</a>
        </div>
      </section>

      <Footer />
    </div>
  </div>
</Base>
