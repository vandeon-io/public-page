---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import StepGlyph from '../components/StepGlyph.astro';
import HeroViz from '../components/HeroViz.jsx';
import { LINKS } from '../consts.js';
---
<Base
  title="PortRun — deploy full-stack systems, at vps prices"
  description="PortRun deploys your frontend, backend, and database on plain VPS servers — no hyperscaler markup. From a side project to a small company."
>
  <div data-screen-label="01 Landing">
    <div class="wrap">
      <Nav current="product" />

      <!-- Hero -->
      <section class="hero">
        <div class="hero-grid">
          <div class="hero-text reveal in">
            <span class="kbd-tag"><span class="kbd-dot"></span> deploy full-stack systems · at vps prices, not hyperscaler prices</span>
            <h1 class="hero-h">Frontend, backend, database.<br /><em>All from one console.</em></h1>
            <p class="hero-sub">
              PortRun gives you three building blocks — frontend, backend, and database. Set each one up and deploy it, right from your browser. No servers to log into, no configs to write by hand.
            </p>
            <div class="hero-cta">
              <a class="btn btn-primary btn-lg" href={LINKS.app} target="_blank" rel="noopener">
                launch app <span class="btn-arrow">→</span>
              </a>
              <a class="btn btn-ghost btn-lg" href="#how">see how it works</a>
            </div>
            <div class="hero-trust">
              <span>frontend + backend + database</span>
              <span class="hero-trust-sep"></span>
              <span>vps pricing, not hyperscaler</span>
              <span class="hero-trust-sep"></span>
              <span>side project to small company</span>
            </div>
          </div>

          <div class="hero-visual reveal in">
            <HeroViz client:load variant="flow" accent="var(--accent)" />
            <div class="viz-caption">
              <span><b>you</b> → portrun web app → <b>your servers</b></span>
              <span>·</span>
              <span>provisioned &amp; configured automatically</span>
            </div>
          </div>
        </div>
      </section>

      <!-- How it works -->
      <section class="section" id="how">
        <div class="sect-head reveal">
          <span class="sect-tag">§ how it works</span>
          <h2 class="sect-h">From a GitHub repo to a running system in <em>three steps</em>.</h2>
          <p class="sect-sub">No runbooks, no pipelines, no server setup. You describe your app in the browser — PortRun does the rest.</p>
        </div>
        <div class="steps reveal">
          <article class="step">
            <span class="step-id">01</span>
            <span class="step-rule"></span>
            <h3 class="step-title">Model your system</h3>
            <p class="step-body">Create a project and add modules for each part of your app — frontend, backend, and database. It's a picture of your system, built in the browser.</p>
            <div class="step-glyph"><StepGlyph kind="modules" /></div>
          </article>
          <article class="step">
            <span class="step-id">02</span>
            <span class="step-rule"></span>
            <h3 class="step-title">Connect your code</h3>
            <p class="step-body">Link your GitHub repo so PortRun knows exactly what to build and run. No pipelines to write.</p>
            <div class="step-glyph"><StepGlyph kind="github" /></div>
          </article>
          <article class="step">
            <span class="step-id">03</span>
            <span class="step-rule"></span>
            <h3 class="step-title">Deploy</h3>
            <p class="step-body">Deploy each module from the console. PortRun sets up its server and ships it — no SSH, no manual config. Every update after is just one more click.</p>
            <div class="step-glyph"><StepGlyph kind="ship" /></div>
          </article>
        </div>
      </section>

      <!-- Capabilities -->
      <section class="section" style="padding-top: 0; border-top: none;">
        <div class="sect-head reveal" style="margin-bottom: 40px;">
          <span class="sect-tag">§ what you get</span>
          <h2 class="sect-h">One console. The whole lifecycle.</h2>
        </div>
        <div class="caps reveal">
          <div class="cap">
            <div class="cap-k">PROVISION</div>
            <div class="cap-t">Servers, set up</div>
            <p class="cap-b">Networking, users, runtimes and dependencies configured for you on connect.</p>
          </div>
          <div class="cap">
            <div class="cap-k">DEPLOY</div>
            <div class="cap-t">One-click rollouts</div>
            <p class="cap-b">Ship a new version across the fleet, with safe rollback the moment health drifts.</p>
          </div>
          <div class="cap">
            <div class="cap-k">OBSERVE</div>
            <div class="cap-t">Health at a glance</div>
            <p class="cap-b">Status, metrics and logs wired up automatically the moment a service comes online.</p>
          </div>
          <div class="cap">
            <div class="cap-k">CONTROL</div>
            <div class="cap-t">From one to many</div>
            <p class="cap-b">The same simple console whether you run a single box or a multi-region fleet.</p>
          </div>
        </div>
      </section>

      <!-- Economics -->
      <section class="section" style="padding-top: 0; border-top: none;">
        <div class="sect-head reveal" style="margin-bottom: 40px;">
          <span class="sect-tag">§ pricing</span>
          <h2 class="sect-h">VPS economics, not <em>hyperscaler prices</em>.</h2>
          <p class="sect-sub">Frontend, backend, and database each run as plain virtual servers — not managed services billed by the request. You're renting the box, not someone else's markup on it.</p>
        </div>
        <div class="caps reveal" style="grid-template-columns: repeat(3, 1fr);">
          <div class="cap">
            <div class="cap-k">COMPUTE</div>
            <div class="cap-t">Plain vps pricing</div>
            <p class="cap-b">A flat monthly rate per server — the same instance you could rent directly, not a managed-service surcharge.</p>
          </div>
          <div class="cap">
            <div class="cap-k">NO METERING</div>
            <div class="cap-t">Flat, predictable bills</div>
            <p class="cap-b">No per-request fees, no metered egress, no surprise line items at the end of the month.</p>
          </div>
          <div class="cap">
            <div class="cap-k">RIGHT-SIZED</div>
            <div class="cap-t">Side project to small company</div>
            <p class="cap-b">Sized for real small-to-medium teams — not enterprise tiers built around hyperscaler contracts.</p>
          </div>
        </div>
      </section>

      <!-- CTA band -->
      <section class="cta-band reveal">
        <h2 class="cta-h">Stop paying hyperscaler prices.</h2>
        <p class="cta-sub">Let PortRun provision, configure, and run your frontend, backend, and database — on plain vps pricing, from a side project to a small company.</p>
        <div class="cta-actions">
          <a class="btn btn-primary btn-lg" href={LINKS.app} target="_blank" rel="noopener">
            launch app <span class="btn-arrow">→</span>
          </a>
          <a class="btn btn-ghost btn-lg" href="#how">see how it works</a>
        </div>
      </section>

      <Footer />
    </div>
  </div>
</Base>
