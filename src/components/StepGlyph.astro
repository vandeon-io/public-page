---
// Small static SVGs for the "how it works" steps.
// Accent parts use var(--accent); dim parts var(--fg-dimmer). No JS shipped.
const { kind } = Astro.props;
const A = 'var(--accent)';
const DIM = 'var(--fg-dimmer)';
---
{kind === 'modules' && (
  <svg viewBox="0 0 200 44" style="width:100%;height:44px;display:block;" preserveAspectRatio="xMinYMid meet">
    <line x1="54" y1="22" x2="68" y2="22" stroke={DIM} stroke-width="1" />
    <line x1="118" y1="22" x2="132" y2="22" stroke={DIM} stroke-width="1" />
    <rect x="0" y="12" width="54" height="20" rx="3" fill="none" stroke={A} stroke-width="1.4" />
    <text x="27" y="25.5" font-size="7.5" text-anchor="middle" font-family="var(--mono)" fill="var(--fg-dim)">frontend</text>
    <rect x="68" y="12" width="50" height="20" rx="3" fill="none" stroke={DIM} stroke-width="1" />
    <text x="93" y="25.5" font-size="7.5" text-anchor="middle" font-family="var(--mono)" fill="var(--fg-dim)">backend</text>
    <rect x="132" y="12" width="56" height="20" rx="3" fill="none" stroke={DIM} stroke-width="1" />
    <text x="160" y="25.5" font-size="7.5" text-anchor="middle" font-family="var(--mono)" fill="var(--fg-dim)">database</text>
  </svg>
)}

{kind === 'github' && (
  <svg viewBox="0 0 200 44" style="width:100%;height:44px;display:block;" preserveAspectRatio="xMinYMid meet">
    <circle cx="14" cy="22" r="12" fill="none" stroke={DIM} stroke-width="1.2" />
    <path d="M14 12.6c-2.4 0-4.3 1.9-4.3 4.3 0 1.9 1.2 3.5 2.9 4.1.2 0 .3-.1.3-.2v-.8c-1.2.3-1.5-.5-1.5-.5-.2-.5-.5-.7-.5-.7-.4-.3 0-.3 0-.3.4 0 .7.5.7.5.4.7 1.1.5 1.4.4 0-.3.2-.5.3-.7-1-.1-2-.5-2-2.2 0-.5.2-.9.5-1.2 0-.2-.2-.6 0-1.2 0 0 .4-.1 1.2.5.4-.1.7-.2 1.1-.2.4 0 .8 0 1.1.2.8-.6 1.2-.5 1.2-.5.2.6 0 1 0 1.2.3.3.5.7.5 1.2 0 1.7-1 2.1-2 2.2.2.2.3.5.3.9v1.3c0 .1.1.3.4.2 1.7-.6 2.8-2.2 2.8-4.1 0-2.4-1.9-4.3-4.3-4.3z" fill={DIM} />
    <line x1="34" y1="22" x2="118" y2="22" stroke={DIM} stroke-width="1" stroke-dasharray="4 4" />
    <path d="M112 17 l6 5 l-6 5" fill="none" stroke={A} stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
    <text x="126" y="18" font-size="8.5" font-family="var(--mono)" fill="var(--fg-dim)">main</text>
    <text x="126" y="30" font-size="8.5" font-family="var(--mono)" fill={A}>linked ✓</text>
  </svg>
)}

{kind === 'ship' && (
  <svg viewBox="0 0 200 44" style="width:100%;height:44px;display:block;" preserveAspectRatio="xMinYMid meet">
    <line x1="0" y1="22" x2="200" y2="22" stroke={DIM} stroke-width="1" stroke-dasharray="4 4" />
    <circle cx="20" cy="22" r="4" fill="var(--bg)" stroke={DIM} stroke-width="1.5" />
    <circle cx="70" cy="22" r="4" fill="var(--bg)" stroke={DIM} stroke-width="1.5" />
    <circle cx="120" cy="22" r="4" fill="var(--bg)" stroke={DIM} stroke-width="1.5" />
    <circle cx="170" cy="22" r="4" fill={A} stroke={A} stroke-width="1.5" />
    <text x="200" y="14" font-size="9" text-anchor="end" font-family="var(--mono)" fill={A}>prod</text>
  </svg>
)}
