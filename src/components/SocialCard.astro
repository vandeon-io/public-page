---
import { LINKS } from '../consts.js';
const { p } = Astro.props;
const href = LINKS[p.href];
const live = href && href !== '#';
---
<a class="social" href={href} target="_blank" rel="noopener">
  <div class="social-top">
    <div class="social-icon">
      {p.id === 'linkedin' && (
        <svg viewBox="0 0 24 24" fill="var(--accent)" aria-hidden="true">
          <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3V9zm6 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.74V21h-4v-5.3c0-1.27-.02-2.9-1.9-2.9-1.9 0-2.2 1.38-2.2 2.8V21H9V9z" />
        </svg>
      )}
      {p.id === 'telegram' && (
        <svg viewBox="0 0 24 24" fill="var(--accent)" aria-hidden="true">
          <path d="M21.8 4.3 18.4 20c-.25 1.12-.92 1.4-1.86.87l-5.14-3.79-2.48 2.39c-.27.27-.5.5-1.03.5l.37-5.23 9.52-8.6c.41-.37-.09-.57-.64-.2L5.86 13.1l-5.07-1.59c-1.1-.34-1.12-1.1.23-1.63L20.4 2.7c.92-.34 1.72.22 1.4 1.6z" />
        </svg>
      )}
    </div>
    <span class="social-go">{live ? 'open ↗' : 'link soon ↗'}</span>
  </div>
  <div>
    <h3 class="social-name">{p.name}</h3>
    <p class="social-handle">{p.handle}</p>
  </div>
  <p class="social-purpose">{p.purpose}</p>
  <div class="social-tags">
    {p.tags.map((tg) => <span class="social-tag">{tg}</span>)}
  </div>
</a>
