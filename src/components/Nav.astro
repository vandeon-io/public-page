---
import AppLink from './AppLink.astro';
// current: 'product' | 'pricing' | 'follow' — marks the active link
const { current } = Astro.props;
---
<nav class="nav">
  <a class="nav-brand" href="/" aria-label="Vandeon home">
    <svg class="nav-brand-mark" viewBox="0 0 30 30" aria-hidden="true">
      <rect x="1.5" y="1.5" width="27" height="27" fill="none" stroke="currentColor" stroke-opacity="0.15" />
      <rect x="4.5" y="4.5" width="21" height="21" fill="none" stroke="currentColor" />
      <path d="M10.5 10.5 L15 19.2 M19.5 10.5 L15 19.2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
      <circle cx="10.5" cy="10.5" r="1.5" fill="currentColor" />
      <circle cx="19.5" cy="10.5" r="1.5" fill="currentColor" />
      <circle cx="15" cy="19.4" r="2.2" class="nav-brand-node" />
    </svg>
    <span>vandeon</span>
  </a>
  <div class="nav-links">
    <a class={'nav-link hide-sm' + (current === 'product' ? ' is-current' : '')} href="/#how">product</a>
    <a class={'nav-link' + (current === 'pricing' ? ' is-current' : '')} href="/pricing">pricing</a>
    {/* follow page hidden until the LinkedIn/Telegram channels are live — re-enable to restore */}
    {/* <a class={'nav-link' + (current === 'follow' ? ' is-current' : '')} href="/follow">follow</a> */}
    <AppLink class="btn btn-primary" />
  </div>
</nav>
